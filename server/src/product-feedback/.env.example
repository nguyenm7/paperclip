# Public gateway. Keep every value in the deployment secret store.
PRODUCT_FEEDBACK_DATABASE_URL=postgres://feedback_gateway:replace-me@database.example/paperclip_feedback
PRODUCT_FEEDBACK_CONTACT_RETENTION_DAYS=90
PRODUCT_FEEDBACK_CONTACT_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
PRODUCT_FEEDBACK_GRANT_SIGNING_SECRET=replace-with-at-least-32-random-characters
PRODUCT_FEEDBACK_ISSUER_ID=replace-with-a-unique-paperclip-environment-id
PRODUCT_FEEDBACK_ISSUER_SECRET=replace-with-at-least-32-random-characters
PRODUCT_FEEDBACK_INSTALLATION_REF=replace-with-an-opaque-installation-reference
PRODUCT_FEEDBACK_SUBMISSION_MODE=production_feedback
PRODUCT_FEEDBACK_POSTHOG_WEBHOOK_SECRET=whsec_replace-with-standard-webhook-secret
PRODUCT_FEEDBACK_POSTHOG_SURVEY_ID=replace-with-survey-id
PRODUCT_FEEDBACK_POSTHOG_QUESTION_ID=replace-with-question-id
PORT=8080

# Local canary only. These are forbidden when submission mode is production_feedback.
# PRODUCT_FEEDBACK_SUBMISSION_MODE=local_validation
# PRODUCT_FEEDBACK_VALIDATION_RUN_ID=replace-with-a-canary-run-id
# PRODUCT_FEEDBACK_VALIDATION_EXPIRES_AT=2099-01-01T00:00:00.000Z
