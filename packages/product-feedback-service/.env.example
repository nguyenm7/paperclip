# Gateway: public ingress process. Do not give this process an Asana access token.
PRODUCT_FEEDBACK_DATABASE_URL=postgres://feedback_gateway:replace-me@database.example/paperclip_feedback
PRODUCT_FEEDBACK_CONTACT_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
PRODUCT_FEEDBACK_GRANT_SIGNING_SECRET=replace-with-at-least-32-random-characters
PRODUCT_FEEDBACK_ISSUER_ID=paperclip-local-canary
PRODUCT_FEEDBACK_ISSUER_SECRET=replace-with-at-least-32-random-characters
PRODUCT_FEEDBACK_INSTALLATION_REF=replace-with-an-opaque-installation-reference
PRODUCT_FEEDBACK_SUBMISSION_MODE=local_validation
PRODUCT_FEEDBACK_VALIDATION_RUN_ID=replace-with-a-canary-run-id
PRODUCT_FEEDBACK_VALIDATION_EXPIRES_AT=2099-01-01T00:00:00.000Z
PRODUCT_FEEDBACK_POSTHOG_WEBHOOK_SECRET=whsec_replace-with-standard-webhook-secret
PRODUCT_FEEDBACK_POSTHOG_SURVEY_ID=replace-with-survey-id
PRODUCT_FEEDBACK_POSTHOG_QUESTION_ID=replace-with-question-id
PRODUCT_FEEDBACK_ASANA_PROJECT_GID=replace-with-project-gid
PRODUCT_FEEDBACK_ASANA_WEBHOOK_REF=replace-with-at-least-32-random-characters
PRODUCT_FEEDBACK_PUBLIC_BASE_URL=https://feedback.example.com
PORT=8080

# Worker: private process. It has Asana access but no public ingress role.
PRODUCT_FEEDBACK_ASANA_ACCESS_TOKEN=replace-with-restricted-service-account-token
PRODUCT_FEEDBACK_ASANA_VALIDATION_SECTION_GID=replace-with-validation-section-gid
PRODUCT_FEEDBACK_ASANA_NEW_SECTION_GID=replace-with-new-section-gid
PRODUCT_FEEDBACK_ASANA_CUSTOM_FIELDS_JSON={}
PRODUCT_FEEDBACK_ASANA_API_BASE_URL=https://app.asana.com/api/1.0

# General Feedback Reviewer runtime. Bind SLACK_BOT_TOKEN from the Paperclip
# secret vault; never copy the token into this file or a shell history.
SLACK_BOT_TOKEN=projected-by-paperclip-secret-binding
PRODUCT_FEEDBACK_SLACK_TEAM_ID=T0B1YJH3M8X
PRODUCT_FEEDBACK_SLACK_CHANNEL_ID=C0BUDPC3SRH
PRODUCT_FEEDBACK_SLACK_CHANNEL_NAME=in-product-feedback
PRODUCT_FEEDBACK_PAPERCLIP_REVIEW_BASE_URL=http://127.0.0.1:3132
PRODUCT_FEEDBACK_SLACK_ALLOWED_REVIEWER_IDS=U0123456789
